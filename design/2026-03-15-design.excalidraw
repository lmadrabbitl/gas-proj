    {
      "id": "ODrYBMrG94iUkJJ4eI3i4",
      "type": "text",
      "x": 890.8857203892298,
      "y": 145.75,
      "width": 763.7000122070312,
      "height": 2225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
