      "updated": 1773456102196,
      "link": null,
      "locked": false,
      "text": "Category:\n{\n   code: string\n   name: string\n   type: 'income' | 'expense'\n   description?: string\n   parent_code: string | null\n   created_at: ISO8601 timestamp (2026-03-14T15:23:11Z)\n   updated_at: ISO8601 timestamp\n   is_active: bool\n   subcategories: Category[]\n}\n\nCategoryCreate:\n\n{\n   code: string\n   name: string\n   type: 'income' | 'expense'\n   description?: string\n   parent_code: string | null\n}\n\nCategoryUpdate:\n\n{\n   name?: string\n   type?: 'income' | 'expense'\n   description?: string\n   parent_code?: string | null\n}\n\n\nGET /categories - Lists all user defined categories\nResponse 200:\n{ categories: [Category] }\n\nGET /categories/<code> - Returns data from a single category\nResponse 200:\n{ category: {Category} }\nResponse 404:\n{ error: { code: \"category_not_found\" } }\n\nPOST /categories - Create a new category\nRequest body:\n{CategoryCreate}\nResponse 201:\n{ category: {Category} }\nResponse 400:\n{ error: { code: \"invalid_XXX\" } }\nResponse 409:\n{ error: { code: \"category_code_exists\" } }\n\nPATCH /categories/<code> - Edits an existing category\nResponse body:\n{CategoryUpdate}\nResponse 200: \n{ category: {Category} }\nResponse 404:\n{ error: { code: \"category_not_found\" } }\n\nDELETE /categories/<code> - Soft-deletes a category (deactivates)\nResponse 204: \n<nothing>\nResponse 404:\n{ error: { code: \"category_not_found\" } }\nResponse 409:\n{ error: { code: \"category_has_children\" } }",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Category:\n{\n   code: string\n   name: string\n   type: 'income' | 'expense'\n   description?: string\n   parent_code: string | null\n   created_at: ISO8601 timestamp (2026-03-14T15:23:11Z)\n   updated_at: ISO8601 timestamp\n   is_active: bool\n   subcategories: Category[]\n}\n\nCategoryCreate:\n\n{\n   code: string\n   name: string\n   type: 'income' | 'expense'\n   description?: string\n   parent_code: string | null\n}\n\nCategoryUpdate:\n\n{\n   name?: string\n   type?: 'income' | 'expense'\n   description?: string\n   parent_code?: string | null\n}\n\n\nGET /categories - Lists all user defined categories\nResponse 200:\n{ categories: [Category] }\n\nGET /categories/<code> - Returns data from a single category\nResponse 200:\n{ category: {Category} }\nResponse 404:\n{ error: { code: \"category_not_found\" } }\n\nPOST /categories - Create a new category\nRequest body:\n{CategoryCreate}\nResponse 201:\n{ category: {Category} }\nResponse 400:\n{ error: { code: \"invalid_XXX\" } }\nResponse 409:\n{ error: { code: \"category_code_exists\" } }\n\nPATCH /categories/<code> - Edits an existing category\nResponse body:\n{CategoryUpdate}\nResponse 200: \n{ category: {Category} }\nResponse 404:\n{ error: { code: \"category_not_found\" } }\n\nDELETE /categories/<code> - Soft-deletes a category (deactivates)\nResponse 204: \n<nothing>\nResponse 404:\n{ error: { code: \"category_not_found\" } }\nResponse 409:\n{ error: { code: \"category_has_children\" } }",
      "autoResize": true,
