      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": "j0AGclQyRXEvY00LHhPYt",
      "originalText": "Requirements (functional and !functional)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SNpzkL_Ylica_xZYnF6N9",
      "type": "text",
      "x": -750.283332824707,
      "y": -1100.75,
      "width": 1037.800048828125,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "7iK6C6r-Ymwva4C4-So_9"
      ],
      "frameId": null,
      "index": "ak",
      "roundness": null,
      "seed": 1795634467,
      "version": 1825,
      "versionNonce": 1092537549,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773451567771,
      "link": null,
      "locked": false,
      "text": "User can create, edit, list and delete accounts\nAccounts deleted will be deactivated but stay in the system\nDeactivated accounts will have their code removed so they can be used in a new account\n\nUser can create, edit, list and delete categories\nCategories deleted will be deactivated but stay in the system\nDeactivated categories will have their code removed so they can be used in a new category\nCategories can have subcategories\n\nUser can create, edit, list and delete transactions\nTransactions deleted will be permanently deleted from the system\nTransactions require a leaf category (category with no subcategories)\nTransactions can be transfers, requiring source and destination accounts\nTransfers are recorded as two transactions with opposite amounts in different accounts\nEditing or deleting a transfer will affect both transactions\nUser can add filters, pagination and sorting when listing transactions\nWhen not filtering by one specific account, in case of transfers only the from->to entry will be returned   \nDefault sorting when listing transactions is by date in descending order\n\nUser can request balance for all accounts or a single account\nUser can request a yearly report of any year\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "User can create, edit, list and delete accounts\nAccounts deleted will be deactivated but stay in the system\nDeactivated accounts will have their code removed so they can be used in a new account\n\nUser can create, edit, list and delete categories\nCategories deleted will be deactivated but stay in the system\nDeactivated categories will have their code removed so they can be used in a new category\nCategories can have subcategories\n\nUser can create, edit, list and delete transactions\nTransactions deleted will be permanently deleted from the system\nTransactions require a leaf category (category with no subcategories)\nTransactions can be transfers, requiring source and destination accounts\nTransfers are recorded as two transactions with opposite amounts in different accounts\nEditing or deleting a transfer will affect both transactions\nUser can add filters, pagination and sorting when listing transactions\nWhen not filtering by one specific account, in case of transfers only the from->to entry will be returned   \nDefault sorting when listing transactions is by date in descending order\n\nUser can request balance for all accounts or a single account\nUser can request a yearly report of any year\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
