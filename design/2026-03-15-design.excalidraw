    {
      "id": "LdWG9wloyy6H5yxkTgtQF",
      "type": "text",
      "x": -1349.7777777777756,
      "y": 156.8333333333331,
      "width": 582.933349609375,
      "height": 825,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "-mmmvLKz8KEweiY5zb7tL"
      ],
      "frameId": null,
      "index": "aq",
      "roundness": null,
      "seed": 1951895853,
      "version": 1610,
      "versionNonce": 976682147,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773513682697,
      "link": null,
      "locked": false,
      "text": "User: \n{\n    email: string\n    id: string\n}\n\nUserLogin:\n{\n   email: string\n   password: string\n}\n\nToken:\n{\n   token: string\n    type: string\n    expires_in: integer\n}\n\nGET /auth/me - Retrieves current logged user information \nResponse 200:\n{ user: {User} }\nResponse 401:\n<nothing>\n\nPOST /auth/login - Login user\nRequest body:\n{UserLogin}\nResponse 200:\n{Token}\nResponse 401: \n<nothing>\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "User: \n{\n    email: string\n    id: string\n}\n\nUserLogin:\n{\n   email: string\n   password: string\n}\n\nToken:\n{\n   token: string\n    type: string\n    expires_in: integer\n}\n\nGET /auth/me - Retrieves current logged user information \nResponse 200:\n{ user: {User} }\nResponse 401:\n<nothing>\n\nPOST /auth/login - Login user\nRequest body:\n{UserLogin}\nResponse 200:\n{Token}\nResponse 401: \n<nothing>\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
