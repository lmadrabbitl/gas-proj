      "updated": 1773457527224,
      "link": null,
      "locked": false,
      "text": "Account: \n{\n   code: string\n   name: string\n   type: 'asset' | 'liability'\n   currency: string\n   created_at: ISO8601 timestamp (2026-03-14T15:23:11Z)\n   updated_at: ISO8601 timestamp\n   is_active: bool\n}\n\nAccountCreate:\n{\n   code: string\n   name: string\n   type: 'asset' | 'liability'\n   currency: string\n}\n\nAccountUpdate:\n{\n   name?: string\n   type?: 'asset' | 'liability'\n   currency?: string\n}\n\n\nGET /accounts - Lists all user defined accounts\nResponse 200:\n{ accounts: [Account] }\n\nGET /accounts/<code> - Returns data from a single account\nResponse 200: \n{ account: {Account} }\nResponse 404:\n{ error: { code: \"account_not_found\" } }\n\nPOST /accounts - Create a new account\nRequest body:\n{AccountCreate}\nResponse 201: \n{ account: {Account} }\nResponse 400:\n{ error: { code: \"invalid_XXX\" } }\nResponse 409:\n{ error: { code: \"account_code_exists\" } }\n\nPATCH /accounts/<code> - Edits an existing account\nRequest body:\n{AccountUpdate}\nResponse 200: \n{ account: {Account} }\nResponse 404:\n{ error: { code: \"account_not_found\" } }\n\nDELETE /accounts/<code> - Soft-deletes an account (deactivates)\nResponse 204: \n<nothing>\nResponse 404:\n{ error: { code: \"account_not_found\" } }\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Account: \n{\n   code: string\n   name: string\n   type: 'asset' | 'liability'\n   currency: string\n   created_at: ISO8601 timestamp (2026-03-14T15:23:11Z)\n   updated_at: ISO8601 timestamp\n   is_active: bool\n}\n\nAccountCreate:\n{\n   code: string\n   name: string\n   type: 'asset' | 'liability'\n   currency: string\n}\n\nAccountUpdate:\n{\n   name?: string\n   type?: 'asset' | 'liability'\n   currency?: string\n}\n\n\nGET /accounts - Lists all user defined accounts\nResponse 200:\n{ accounts: [Account] }\n\nGET /accounts/<code> - Returns data from a single account\nResponse 200: \n{ account: {Account} }\nResponse 404:\n{ error: { code: \"account_not_found\" } }\n\nPOST /accounts - Create a new account\nRequest body:\n{AccountCreate}\nResponse 201: \n{ account: {Account} }\nResponse 400:\n{ error: { code: \"invalid_XXX\" } }\nResponse 409:\n{ error: { code: \"account_code_exists\" } }\n\nPATCH /accounts/<code> - Edits an existing account\nRequest body:\n{AccountUpdate}\nResponse 200: \n{ account: {Account} }\nResponse 404:\n{ error: { code: \"account_not_found\" } }\n\nDELETE /accounts/<code> - Soft-deletes an account (deactivates)\nResponse 204: \n<nothing>\nResponse 404:\n{ error: { code: \"account_not_found\" } }\n",
